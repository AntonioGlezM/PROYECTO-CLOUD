&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1270" y="888" width="200" height="20" as="geometry"/></mxCell><mxCell id="ley_acc" value="Acceso" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1275" y="918" width="100" height="26" as="geometry"/></mxCell><mxCell id="ley_cat" value="Catálogo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1387" y="918" width="100" height="26" as="geometry"/></mxCell><mxCell id="ley_dis" value="Diseño" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1499" y="918" width="100" height="26" as="geometry"/></mxCell><mxCell id="ley_con" value="Contratación" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1611" y="918" width="100" height="26" as="geometry"/></mxCell><mxCell id="ley_txt" value="1 / N / 0..1 en cada extremo: cardinalidad (pata de gallo = muchos)&lt;br&gt;R-xx: número de la relación en la tabla 3.2 de arquitectura.md&lt;br&gt;Línea roja gruesa: cadena principal arquitectura → producto&lt;br&gt;Línea gris discontinua: solo referencia, los datos se copian&lt;br&gt;N:M: se resuelve con una entidad intermedia con sus propios datos&lt;br&gt;(PRODUCTO_REGION, REGLA_COMPATIBILIDAD, ARQUITECTURA_ITEM)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1272" y="955" width="450" height="145" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
